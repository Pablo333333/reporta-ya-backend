generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Territorio {
  id                String            @id @default(uuid())
  nombre            String            @unique
  descripcion       String?
  configuracionJson Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  configCategorias  ConfigCategoria[]
  configEstados     ConfigEstado[]
  configPrioridades ConfigPrioridad[]
  configSistema     ConfigSistema[]
  reportes          Reporte[]
  usuarios          Usuario[]

  @@map("territorios")
}

model ConfigSistema {
  id           String      @id @default(uuid())
  clave        String      @unique
  valor        String
  descripcion  String?
  updatedAt    DateTime    @updatedAt
  territorioId String?
  territorio   Territorio? @relation(fields: [territorioId], references: [id])

  @@map("config_sistema")
}

model ConfigCategoria {
  id           String             @id @default(uuid())
  nombre       String             @unique
  descripcion  String?
  color        String?            @default("#000000")
  icono        String?
  activo       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  territorioId String?
  camposExtra  ConfigCampoExtra[]
  territorio   Territorio?        @relation(fields: [territorioId], references: [id])
  reportes     Reporte[]

  @@map("config_categorias")
}

model ConfigCampoExtra {
  id          String          @id @default(uuid())
  nombre      String
  tipo        String
  requerido   Boolean         @default(false)
  categoriaId String
  categoria   ConfigCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@map("config_campos_extra")
}

model ConfigEstado {
  id              String             @id @default(uuid())
  nombre          String             @unique
  color           String?            @default("#000000")
  esFinal         Boolean            @default(false)
  orden           Int                @default(0)
  activo          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  territorioId    String?
  requiereFoto    Boolean            @default(false)
  territorio      Territorio?        @relation(fields: [territorioId], references: [id])
  auditLogsViejos HistorialReporte[] @relation("RelacionEstadoAnterior")
  auditLogsNuevos HistorialReporte[] @relation("RelacionEstadoNuevo")
  reportes        Reporte[]

  @@map("config_estados")
}

model ConfigPrioridad {
  id           String      @id @default(uuid())
  nombre       String      @unique
  color        String?     @default("#000000")
  nivel        Int         @default(0)
  activo       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  territorioId String?
  territorio   Territorio? @relation(fields: [territorioId], references: [id])
  reportes     Reporte[]

  @@map("config_prioridades")
}

model LogAccion {
  id        String   @id @default(uuid())
  usuarioId String?
  accion    String
  entidad   String
  entidadId String
  detalles  Json?
  fecha     DateTime @default(now())
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("logs_acciones")
}

model Usuario {
  id           String             @id @default(uuid())
  email        String             @unique
  password     String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  pushToken    String?
  rolId        String
  territorioId String?
  comunicados  Comunicado[]
  historial    HistorialReporte[]
  logsAcciones LogAccion[]
  puntos       PuntosCiudadanos[]
  reportes     Reporte[]
  rol          Rol                @relation(fields: [rolId], references: [id])
  territorio   Territorio?        @relation(fields: [territorioId], references: [id])

  @@map("usuarios")
}

model Rol {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String?
  permisos    RolPermiso[]
  usuarios    Usuario[]

  @@map("roles")
}

model Permiso {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String?
  roles       RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     String
  permisoId String
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model Reporte {
  id                   String             @id @default(uuid())
  comentario           String?
  fotoUrl              String?
  latitud              Float
  longitud             Float
  fechaCreacion        DateTime           @default(now())
  reportanteId         String?
  categoriaId          String
  estadoId             String
  prioridadId          String
  updatedAt            DateTime           @updatedAt
  comentarioResolucion String?
  fotoEvidenciaUrl     String?
  sincronizadoEn       DateTime?
  zona                 String?
  audioUrl             String?
  transcripcionVoz     String?
  validadoCiudadano    Boolean            @default(true)
  valoresCamposExtra   Json?
  territorioId         String?
  historial            HistorialReporte[]
  categoria            ConfigCategoria    @relation(fields: [categoriaId], references: [id])
  estado               ConfigEstado       @relation(fields: [estadoId], references: [id])
  prioridad            ConfigPrioridad    @relation(fields: [prioridadId], references: [id])
  reportante           Usuario?           @relation(fields: [reportanteId], references: [id])
  territorio           Territorio?        @relation(fields: [territorioId], references: [id])

  @@map("reportes")
}

model PuntosCiudadanos {
  id        String   @id @default(uuid())
  usuarioId String
  puntos    Int
  motivo    String
  fecha     DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("puntos_ciudadanos")
}

model HistorialReporte {
  id               String        @id @default(uuid())
  reporteId        String
  usuarioId        String?
  estadoAnteriorId String?
  estadoNuevoId    String
  fecha            DateTime      @default(now())
  comentario       String?
  estadoAnterior   ConfigEstado? @relation("RelacionEstadoAnterior", fields: [estadoAnteriorId], references: [id])
  estadoNuevo      ConfigEstado  @relation("RelacionEstadoNuevo", fields: [estadoNuevoId], references: [id])
  reporte          Reporte       @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  usuario          Usuario?      @relation(fields: [usuarioId], references: [id])

  @@map("historial_reportes")
}

model Comunicado {
  id                  String   @id @default(uuid())
  mensaje             String
  fechaPublicacion    DateTime @default(now())
  duracionRestriccion Int?
  responsableId       String
  responsable         Usuario  @relation(fields: [responsableId], references: [id])

  @@map("comunicados")
}

model AprendizajeIa {
  id                String   @id @default(uuid())
  textoReporte      String
  categoriaSugerida String
  categoriaReal     String
  corregido         Boolean  @default(false)
  fecha             DateTime @default(now())

  @@map("aprendizaje_ia")
}
